APP_NAME="Очумелые ручки CI"
APP_ENV=testing
APP_KEY=
# APP_KEY may be left blank in template. CI generates it during workflow.
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=:memory:
DB_USERNAME=null
DB_PASSWORD=null

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stack
LOG_LEVEL=error
BCRYPT_ROUNDS=4
