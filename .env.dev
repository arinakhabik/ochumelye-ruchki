APP_NAME="Очумелые ручки"
APP_ENV=dev
APP_KEY=
# APP_KEY may be left blank in template. Generate locally: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost/ochumelye-ruchki/public

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ochumelye_ruchki_dev
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=debug
