APP_NAME="Очумелые ручки"
APP_ENV=uat
APP_KEY=
# APP_KEY may be left blank in template. Generate on UAT server: php artisan key:generate
APP_DEBUG=false
APP_URL=https://uat.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ochumelye_ruchki_uat
DB_USERNAME=uat_user
DB_PASSWORD=change_me

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=info
